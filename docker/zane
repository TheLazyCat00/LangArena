FROM langarena:base

ARG cli_version=v0.15
ARG compiler_version=v0.32
ARG cli_sha256=d5f89774a8694c9cabe5a0782d46cc1e2f1a9e5f03c790a4b8480b66f8346232
ENV ZANE_HOME=/opt/zane-home
RUN curl -fL "https://github.com/zane-lang/zane/releases/download/${cli_version}/zane-linux-x86_64" -o /usr/local/bin/zane \
    && echo "${cli_sha256}  /usr/local/bin/zane" | sha256sum -c - \
    && chmod +x /usr/local/bin/zane \
    && zane toolchain install "${compiler_version}"

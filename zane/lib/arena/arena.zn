Int start(this Host, name String) mut => Int(this!_ffiStart(name));
@primitives$I64 _ffiFinish(this Host, started @primitives$I64, actual @primitives$I64, expected @primitives$I64) mut foreign "arena_finish";
Int finish(this Host, started Int, actual Int, expected Int) mut => Int(this!_ffiFinish(started, actual, expected));
@primitives$Unit _ffiSummary(this Host, seconds @primitives$F64, count @primitives$I64, failures @primitives$I64) mut foreign "arena_summary";
Unit summary(this Host, seconds Float, count Int, failures Int) mut {
  this!_ffiSummary(seconds, count, failures);
  return Unit();
}

@primitives$Unit _ffiFail(this Host, message @primitives$String) mut foreign "arena_fail";
Unit fail(this Host, message String) mut {
  this!_ffiFail(message);
  return Unit();
}

@primitives$Unit _ffiExit(this Host, status @primitives$I64) mut foreign "arena_exit";
Unit exit(this Host, status Int) mut {
  this!_ffiExit(status);
  return Unit();
}

@primitives$Unit _ffiAnnounce(this Host) mut foreign "arena_announce";
Unit announce(this Host) mut {
  this!_ffiAnnounce();
  return Unit();
}


package arena;
import core$;
import math$;
type Host = #handle {
  cType = "arena_host";
}

type Config = #handle {
  cType = "arena_config";
  free = "arena_config_free";
}

type Buffer = #handle {
  cType = "arena_buffer";
  free = "arena_buffer_free";
}

type Sorted = #handle {
  cType = "arena_sorted";
  free = "arena_sorted_free";
}

@primitives$String _ffiRead(this Host, path @primitives$String) mut foreign "arena_read";
String read(this Host, path String) mut => String(this!_ffiRead(path));

package arena;
import core$;
import math$;
type IntMap = struct {
  keys List<Int>;
  values List<Int>;
  used List<Bool>;
  entries Int;
}

IntMap(capacity Int) => init {
  keys=filled(capacity, Int(0));
  values=filled(capacity, Int(0));
  used=filled(capacity, Bool(false));
  entries=Int(0);
}

Int slot(this IntMap, key Int) {
  capacity Int=this.keys:size();
  index Int=rem(u32(key*2654435761), capacity)+1;
  probe Int=Int(1);
  probe!to(capacity) {
    if(~this.used[index]) {
      return index;
    }
    if(this.keys[index]==key) {
      return index;
    }
    index=rem(index, capacity)+1;
  }
  return Int(0);
}

Int get(this IntMap, key Int) {
  index Int=this:slot(key);
  if(index==0) {
    return Int(0);
  }
  if(this.used[index]) {
    return this.values[index];
  }
  return Int(0);
}

Bool has(this IntMap, key Int) {
  index Int=this:slot(key);
  if(index==0) {
    return Bool(false);
  }
  return this.used[index];
}

Unit put(this IntMap, key Int, value Int) mut {
  index Int=this:slot(key);
  if(index>0) {
    if(~this.used[index]) {
      this.entries=this.entries+1;
    }
    this.used[index]=Bool(true);
    this.keys[index]=key;
    this.values[index]=value;
  }
  return Unit();
}

// Open addressing over a table of slots, each 0 (empty) or the 1-based
// index of its entry in keys/values. Empty slots hold no String, so a large
// map costs one Int per slot to create, not one String allocation.
type StringMap = struct {
  slots List<Int>;
  keys List<String>;
  values List<Int>;
  entries Int;
}

StringMap(capacity Int) => init {
  slots=filled(capacity, Int(0));
  keys=List(String);
  values=List(Int);
  entries=Int(0);
}

// The slot that holds key, or the empty slot where it belongs; 0 if full.
// The djb2 hash is mixed, as IntMap mixes its keys: keys that differ in
// their last characters, such as "item_1" and "item_2", hash to adjacent
// values, and linear probing would make one long cluster of them.
Int slot(this StringMap, key String) {
  capacity Int=this.slots:size();
  index Int=rem(u32(hash(key)*2654435761), capacity)+1;
  probe Int=Int(1);
  probe!to(capacity) {
    entry Int=this.slots[index];
    if(entry==0) {
      return index;
    }
    if(this.keys[entry]==key) {
      return index;
    }
    index=rem(index, capacity)+1;
  }
  return Int(0);
}

Int get(this StringMap, key String) {
  index Int=this:slot(key);
  if(index==0) {
    return Int(0);
  }
  entry Int=this.slots[index];
  if(entry==0) {
    return Int(0);
  }
  return this.values[entry];
}

Bool has(this StringMap, key String) {
  index Int=this:slot(key);
  if(index==0) {
    return Bool(false);
  }
  return this.slots[index]>0;
}

Unit put(this StringMap, key String, value Int) mut {
  index Int=this:slot(key);
  if(index>0) {
    entry Int=this.slots[index];
    if(entry==0) {
      this.keys!push(key);
      this.values!push(value);
      this.entries=this.entries+1;
      this.slots[index]=this.entries;
    }
    if(entry>0) {
      this.values[entry]=value;
    }
  }
  return Unit();
}

package binarytrees;
import core$;
import math$;
import arena$;

type Tree = #variant {leaf Int;branch Branch;}
type Branch = #struct {item Int;left Tree;right Tree;}
Branch(item Int,left ^Tree,right ^Tree) => init{item;left;right;}
^Tree build(item Int,depth Int) {if(depth==0) {return Tree.leaf(item);}delta Int=shiftLeft(Int(1),depth-1);return Tree.branch(Branch(item,build(item-delta,depth-1),build(item+delta,depth-1)));}
Int sum(tree Tree) => match(tree) {v leaf => v+1;b branch => b.item+1+sum(b.left)+sum(b.right);}
type Node = struct {item Int;left Int;right Int;}
Node(item Int,left Int,right Int) => init{item;left;right;}
type State = #struct {nodes List<Node>;result Int;depth Int;object Bool;}
State(cfg Config,name String) => init{nodes=List(Node);result=Int(0);depth=cfg:integer(name,"depth");object=name=="Binarytrees::Obj";}
Int build(this State,item Int,depth Int) mut {index Int=this.nodes:size()+1;this.nodes!push(Node(item,Int(0),Int(0)));if(depth>0) {delta Int=shiftLeft(Int(1),depth-1);left Int=this!build(item-delta,depth-1);right Int=this!build(item+delta,depth-1);this.nodes[index]=Node(item,left,right);}return index;}
Int sum(this State,index Int) {node Node=this.nodes[index];total Int=node.item+1;if(node.left>0) {total=total+this:sum(node.left);}if(node.right>0) {total=total+this:sum(node.right);}return total;}
Unit prepare(this State) mut {return Unit();}
Unit step(this State,iteration Int) mut {mode Bool=if(this.object) {tree Tree=build(Int(0),this.depth);this.result=u32(this.result+sum(tree));}mode:else() {this.nodes=List(Node);depth Int=this.depth;index Int=this!build(Int(0),depth);this.result=u32(this.result+this:sum(index));}return Unit();}
Int checksum(this State) => this.result;

Unit resetRandom(this State) mut {return Unit();}

Result execute(this Host,cfg Config,name String) mut {
 state State=State(cfg,name);state!prepare();iterations Int=cfg:integer(name,"iterations");warm Int=max(Int(1),iterations/5);
 if(cfg:has(name,"warmup_iterations")) {warm=cfg:integer(name,"warmup_iterations");}
 i Int=Int(0);i!to(warm-1) {state!step(i);}state!resetRandom();started Int=this!start(name);
 j Int=Int(0);j!to(iterations-1) {state!step(j);}actual Int=u32(state:checksum());expected Int=u32(cfg:integer(name,"checksum"));
 nanos Int=this!finish(started,actual,expected);failed Int=Int(0);if(actual~=expected) {failed=Int(1);}return Result(nanos,failed);
}

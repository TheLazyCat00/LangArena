package bwt;
import core$;
import math$;
import arena$;
import codec$;
type Encoded = struct {
  data String;
  original Int;
}

Encoded(data String, original Int) => init {
  data;
  original;
}

type Suffixes = #struct {
  indices List<Int>;
  rank List<Int>;
  offset Int;
}

Suffixes(indices List<Int>, rank List<Int>, offset Int) => init {
  indices;
  rank;
  offset;
}

Int compare(this Suffixes, a Int, b Int) {
  if(this.rank[a]<this.rank[b]) {
    return ~Int(1);
  }
  if(this.rank[a]>this.rank[b]) {
    return Int(1);
  }
  n Int=this.rank:size();
  left Int=this.rank[rem(a-1+this.offset, n)+1];
  right Int=this.rank[rem(b-1+this.offset, n)+1];
  if(left<right) {
    return ~Int(1);
  }
  if(left>right) {
    return Int(1);
  }
  return Int(0);
}

Int up(this Suffixes, index Int, pivot Int, high Int) {
  i Int=index;
  k Int=Int(1);
  k!to(high-index+1) {
    if(this:compare(this.indices[i], pivot)>=0) {
      return i;
    }
    i=i+1;
  }
  return i;
}

Int down(this Suffixes, index Int, pivot Int, low Int) {
  i Int=index;
  k Int=Int(1);
  k!to(index-low+1) {
    if(this:compare(this.indices[i], pivot)<=0) {
      return i;
    }
    i=i-1;
  }
  return i;
}

type Partition = struct {
  left Int;
  right Int;
}

Partition(left Int, right Int) => init {
  left;
  right;
}

Partition partition(this Suffixes, low Int, high Int) mut {
  pivot Int=this.indices[(low+high)/2];
  i Int=low;
  j Int=high;
  k Int=Int(1);
  k!to(high-low+1) {
    if(i>j) {
      return Partition(i, j);
    }
    i=this:up(i, pivot, high);
    j=this:down(j, pivot, low);
    if(i<=j) {
      v Int=this.indices[i];
      this.indices[i]=this.indices[j];
      this.indices[j]=v;
      i=i+1;
      j=j-1;
    }
  }
  return Partition(i, j);
}

Unit sort(this Suffixes, low Int, high Int) mut {
  if(low>=high) {
    return Unit();
  }
  p Partition=this!partition(low, high);
  this!sort(low, p.right);
  this!sort(p.left, high);
  return Unit();
}

Encoded encode(input String) {
  inputBytes Buffer=bytes(input);
  n Int=length(input);
  if(n==0) {
    return Encoded(String(""), Int(0));
  }
  counts List<Int> = frequencies(input);
  positions List<Int> = filled(Int(256), Int(0));
  total Int=Int(0);
  i Int=Int(1);
  i!to(Int(256)) {
    positions[i]=total;
    total=total+counts[i];
  }
  indices List<Int> = filled(n, Int(0));
  seen List<Int> = filled(Int(256), Int(0));
  j Int=Int(1);
  j!to(n) {
    value Int=byte(inputBytes, j)+1;
    position Int=positions[value]+seen[value]+1;
    indices[position]=j;
    seen[value]=seen[value]+1;
  }
  ranks List<Int> = filled(n, Int(0));
  current Int=Int(0);
  previous Int=byte(inputBytes, indices[Int(1)]);
  p Int=Int(1);
  p!to(n) {
    index Int=indices[p];
    value Int=byte(inputBytes, index);
    if(value~=previous) {
      current=current+1;
      previous=value;
    }
    ranks[index]=current;
  }
  suffixes Suffixes=Suffixes(indices, ranks, Int(1));
  round Int=Int(1);
  round!to(Int(63)) {
    if(suffixes.offset<n) {
      suffixes!sort(Int(1), n);
      nextRanks List<Int> = filled(n, Int(0));
      q Int=Int(2);
      q!to(n) {
        prior Int=suffixes.indices[q-1];
        index Int=suffixes.indices[q];
        delta Int=Int(0);
        if(suffixes:compare(prior, index)~=0) {
          delta=Int(1);
        }
        nextRanks[index]=nextRanks[prior]+delta;
      }
      suffixes.rank=nextRanks;
      suffixes.offset=suffixes.offset*2;
    }
  }
  out Buffer=buffer(Int(0), Int(0));
  original Int=Int(1);
  q Int=Int(1);
  q!to(n) {
    suffix Int=suffixes.indices[q];
    first Bool=if(suffix==1) {
      out!push(byte(inputBytes, n));
      original=q;
    }
    first:else() {
      out!push(byte(inputBytes, suffix-1));
    }
  }
  return Encoded(out:string(), original);
}

String decode(encoded Encoded) {
  inputBytes Buffer=bytes(encoded.data);
  n Int=length(encoded.data);
  if(n==0) {
    return String("");
  }
  counts List<Int> = frequencies(encoded.data);
  positions List<Int> = filled(Int(256), Int(0));
  total Int=Int(0);
  i Int=Int(1);
  i!to(Int(256)) {
    positions[i]=total;
    total=total+counts[i];
  }
  next List<Int> = filled(n, Int(0));
  seen List<Int> = filled(Int(256), Int(0));
  j Int=Int(1);
  j!to(n) {
    value Int=byte(inputBytes, j)+1;
    position Int=positions[value]+seen[value]+1;
    next[position]=j;
    seen[value]=seen[value]+1;
  }
  out Buffer=buffer(Int(0), Int(0));
  index Int=encoded.original;
  k Int=Int(1);
  k!to(n) {
    index=next[index];
    out!push(byte(inputBytes, index));
  }
  return out:string();
}

type State = #struct {
  n Int;
  data String;
  encoded Encoded;
  decoded String;
  result Int;
  decode Bool;
}

State(cfg Config, name String) => init {
  n=cfg:integer(name, "size");
  data=String("");
  encoded=Encoded(String(""), Int(0));
  decoded=String("");
  result=Int(0);
  decode=name=="Compress::BWTDecode";
}

Unit prepare(this State) mut {
  this.data=testData(this.n);
  if(this.decode) {
    this.encoded=encode(this.data);
  }
  return Unit();
}

Unit step(this State, iteration Int) mut {
  mode Bool=if(this.decode) {
    this.decoded=decode(this.encoded);
    this.result=u32(this.result+length(this.decoded));
  }
  mode:else() {
    this.encoded=encode(this.data);
    this.result=u32(this.result+length(this.encoded.data));
  }
  return Unit();
}

Int checksum(this State) {
  if(this.decode and this.decoded==this.data) {
    return u32(this.result+100000);
  }
  return this.result;
}

Unit resetRandom(this State) mut {
  return Unit();
}

Result execute(this Host, cfg Config, name String) mut {
  state State=State(cfg, name);
  state!prepare();
  iterations Int=cfg:integer(name, "iterations");
  warm Int=max(Int(1), iterations/5);
  if(cfg:has(name, "warmup_iterations")) {
    warm=cfg:integer(name, "warmup_iterations");
  }
  i Int=Int(0);
  i!to(warm-1) {
    state!step(i);
  }
  state!resetRandom();
  started Int=this!start(name);
  j Int=Int(0);
  j!to(iterations-1) {
    state!step(j);
  }
  elapsed Int=this!stop(started);
  actual Int=u32(state:checksum());
  expected Int=u32(cfg:integer(name, "checksum"));
  nanos Int=this!finish(elapsed, actual, expected);
  failed Int=Int(0);
  if(actual~=expected) {
    failed=Int(1);
  }
  return Result(nanos, failed);
}

package life;
import core$;
import math$;
import arena$;

type Cell = #struct {alive Bool;next Bool;neighbors List<Int>;}
Cell() => init{alive=Bool(false);next=Bool(false);neighbors=List(Int);}
type State = #struct {w Int;h Int;cells ListRef<Cell>;rng Rng;}
State(cfg Config,name String) => init{w=cfg:integer(name,"w");h=cfg:integer(name,"h");cells=ListRef(Cell);rng=Rng();}
Unit prepare(this State) mut {i Int=Int(1);i!to(this.w*this.h) {this.cells!push(Cell());}y Int=Int(0);y!to(this.h-1) {x Int=Int(0);x!to(this.w-1) {index Int=y*this.w+x+1;dy Int=~Int(1);dy!to(Int(1)) {dx Int=~Int(1);dx!to(Int(1)) {if(dx~=0 or dy~=0) {ny Int=rem(y+dy+this.h,this.h);nx Int=rem(x+dx+this.w,this.w);this.cells[index].neighbors!push(ny*this.w+nx+1);}}}this.cells[index].alive=this.rng!nextFloat()<Float(0.1);}}return Unit();}
Unit step(this State,iteration Int) mut {i Int=Int(1);i!to(this.cells:size()) {alive Int=Int(0);j Int=Int(1);j!to(this.cells[i].neighbors:size()) {if(this.cells[this.cells[i].neighbors[j]].alive) {alive=alive+1;}}current Bool=if(this.cells[i].alive) {this.cells[i].next=alive==2 or alive==3;}current:else() {this.cells[i].next=alive==3;}}j Int=Int(1);j!to(this.cells:size()) {this.cells[j].alive=this.cells[j].next;}return Unit();}
Int checksum(this State) {fnv Int=Int(2166136261);count Int=Int(0);i Int=Int(1);i!to(this.cells:size()) {value Int=Int(0);if(this.cells[i].alive) {value=Int(1);count=count+1;}fnv=u32(bitXor(fnv,value)*16777619);}return u32(fnv+count);}

Unit resetRandom(this State) mut {return Unit();}

Result execute(this Host,cfg Config,name String) mut {
 state State=State(cfg,name);state!prepare();iterations Int=cfg:integer(name,"iterations");warm Int=max(Int(1),iterations/5);
 if(cfg:has(name,"warmup_iterations")) {warm=cfg:integer(name,"warmup_iterations");}
 i Int=Int(0);i!to(warm-1) {state!step(i);}state!resetRandom();started Int=this!start(name);
 j Int=Int(0);j!to(iterations-1) {state!step(j);}actual Int=u32(state:checksum());expected Int=u32(cfg:integer(name,"checksum"));
 nanos Int=this!finish(started,actual,expected);failed Int=Int(0);if(actual~=expected) {failed=Int(1);}return Result(nanos,failed);
}

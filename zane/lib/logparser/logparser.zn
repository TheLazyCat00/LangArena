package logparser;
import core$;
import math$;
import arena$;
String methods(index Int) {
  if(index==0) {
    return String("GET");
  }
  if(index==1) {
    return String("POST");
  }
  if(index==2) {
    return String("PUT");
  }
  return String("DELETE");
}

String paths(index Int) {
  if(index==0) {
    return String("/index.html");
  }
  if(index==1) {
    return String("/api/users");
  }
  if(index==2) {
    return String("/admin");
  }
  if(index==3) {
    return String("/images/logo.png");
  }
  if(index==4) {
    return String("/etc/passwd");
  }
  return String("/wp-admin/setup.php");
}

String agents(index Int) {
  if(index==0) {
    return String("Mozilla/5.0");
  }
  if(index==1) {
    return String("Googlebot/2.1");
  }
  if(index==2) {
    return String("curl/7.68.0");
  }
  return String("scanner/2.0");
}


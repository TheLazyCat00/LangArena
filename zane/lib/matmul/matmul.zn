Unit step(this State, iteration Int) mut {
  t List<List<Float>> = transpose(this.b);
  n Int=this.a.rows:size();
  c List<List<Float>> = List(List<Float>);
  workers Int=this.threads;
  single Bool=if(workers==1) {
    c=multiplyRows(this.a, t, Int(1), n);
  }
  single!elif(workers==4) {
    c=parallel4(this.a, t);
  }
  single!elif(workers==8) {
    c=parallel8(this.a, t);
  }
  single:else() {
    c=parallel16(this.a, t);
  }
  this.result=u32(this.result+hashFloat(c[n/2+1][n/2+1]));
  return Unit();
}

Int checksum(this State) => this.result;
Unit resetRandom(this State) mut {
  return Unit();
}

Result execute(this Host, cfg Config, name String) mut {
  state State=State(cfg, name);
  if(name=="Matmul::T4") {
    state.threads=Int(4);
  }
  if(name=="Matmul::T8") {
    state.threads=Int(8);
  }
  if(name=="Matmul::T16") {
    state.threads=Int(16);
  }
  state!prepare();
  iterations Int=cfg:integer(name, "iterations");
  warm Int=max(Int(1), iterations/5);
  if(cfg:has(name, "warmup_iterations")) {
    warm=cfg:integer(name, "warmup_iterations");
  }
  i Int=Int(0);
  i!to(warm-1) {
    state!step(i);
  }
  state!resetRandom();
  started Int=this!start(name);
  j Int=Int(0);
  j!to(iterations-1) {
    state!step(j);
  }
  elapsed Int=this!stop(started);
  actual Int=u32(state:checksum());
  expected Int=u32(cfg:integer(name, "checksum"));
  nanos Int=this!finish(elapsed, actual, expected);
  failed Int=Int(0);
  if(actual~=expected) {
    failed=Int(1);
  }
  return Result(nanos, failed);
}

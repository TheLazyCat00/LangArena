package matmul;
import core$;
import math$;
import arena$;
type Matrix = struct {
  rows List<List<Float>>;
}

Matrix(n Int) {
  rows List<List<Float>> = List(List<Float>);
  tmp Float=Float(1.0)/Float(n)/Float(n);
  i Int=Int(0);
  i!to(n-1) {
    row List<Float> = List(Float);
    j Int=Int(0);
    j!to(n-1) {
      row!push(tmp*Float(i-j)*Float(i+j));
    }
    rows!push(row);
  }
  return init {
    rows;
  }
}

type State = #struct {
  a Matrix;
  b Matrix;
  result Int;
  threads Int;
}

State(cfg Config, name String) => init {
  a=Matrix(cfg:integer(name, "n"));
  b=Matrix(cfg:integer(name, "n"));
  result=Int(0);
  threads=Int(1);
}

Unit prepare(this State) mut {
  return Unit();
}

List<List<Float>> transpose(b Matrix) {
  rows List<List<Float>> = List(List<Float>);
  i Int=Int(1);
  i!to(b.rows:size()) {
    row List<Float> = List(Float);
    j Int=Int(1);
    j!to(b.rows:size()) {
      row!push(b.rows[j][i]);
    }
    rows!push(row);
  }
  return rows;
}

List<List<Float>> multiplyRows(a Matrix, t List<List<Float>>, start Int, end Int) {
  out List<List<Float>> = List(List<Float>);
  i Int=start;
  i!to(end) {
    row List<Float> = List(Float);
    j Int=Int(1);
    j!to(t:size()) {
      value Float=Float(0.0);
      k Int=Int(1);
      k!to(t:size()) {
        value=value+a.rows[i][k]*t[j][k];
      }
      row!push(value);
    }
    out!push(row);
  }
  return out;
}

List<List<Float>> parallel4(a Matrix, t List<List<Float>>) {
  n Int=a.rows:size();
  width Int=(n+3)/4;
  chunk0 List<List<Float>> = spawn multiplyRows(a, t, width*0+1, min(n, width*1));
  chunk1 List<List<Float>> = spawn multiplyRows(a, t, width*1+1, min(n, width*2));
  chunk2 List<List<Float>> = spawn multiplyRows(a, t, width*2+1, min(n, width*3));
  chunk3 List<List<Float>> = spawn multiplyRows(a, t, width*3+1, min(n, width*4));
  out List<List<Float>> = List(List<Float>);
  i0 Int=Int(1);
  i0!to(chunk0:size()) {
    row List<Float> = chunk0[i0];
    out!push(row);
  }
  i1 Int=Int(1);
  i1!to(chunk1:size()) {
    row List<Float> = chunk1[i1];
    out!push(row);
  }
  i2 Int=Int(1);
  i2!to(chunk2:size()) {
    row List<Float> = chunk2[i2];
    out!push(row);
  }
  i3 Int=Int(1);
  i3!to(chunk3:size()) {
    row List<Float> = chunk3[i3];
    out!push(row);
  }
  return out;
}


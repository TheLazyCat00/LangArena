package template;
import core$;
import math$;
import arena$;
String firstName(index Int) {
  if(index==0) {
    return String("John");
  }
  if(index==1) {
    return String("Jane");
  }
  if(index==2) {
    return String("Bob");
  }
  if(index==3) {
    return String("Alice");
  }
  if(index==4) {
    return String("Charlie");
  }
  if(index==5) {
    return String("Diana");
  }
  if(index==6) {
    return String("Sarah");
  }
  return String("Mike");
}

String lastName(index Int) {
  if(index==0) {
    return String("Smith");
  }
  if(index==1) {
    return String("Johnson");
  }
  if(index==2) {
    return String("Brown");
  }
  if(index==3) {
    return String("Taylor");
  }
  if(index==4) {
    return String("Wilson");
  }
  if(index==5) {
    return String("Davis");
  }
  if(index==6) {
    return String("Miller");
  }
  return String("Jones");
}

String city(index Int) {
  if(index==0) {
    return String("New York");
  }
  if(index==1) {
    return String("Los Angeles");
  }
  if(index==2) {
    return String("Chicago");
  }
  if(index==3) {
    return String("Houston");
  }
  if(index==4) {
    return String("Phoenix");
  }
  return String("San Francisco");
}

type State = #struct {
  count Int;
  text Buffer;
  rendered String;
  variables StringMap;
  values List<String>;
  pattern Regex;
  result Int;
  parse Bool;
}

State(cfg Config, name String) => init {
  count=cfg:integer(name, "count");
  text=buffer(Int(0), Int(0));
  rendered=String("");
  variables=StringMap(cfg:integer(name, "count")*6+20);
  values=List(String);
  pattern=regex("[{][{]([^}]*)[}][}]", Bool(false));
  result=Int(0);
  parse=name=="Template::Parse";
}

Unit variable(this State, key String, value String) mut {
  index Int=this.values:size()+1;
  this.variables!put(key, index);
  copy String=value;
  this.values!push(copy);
  return Unit();
}

Unit prepare(this State) mut {
  this!variable(String("TITLE"), String("Template title"));
  out ^Buffer=buffer(Int(0), Int(0));
  out!append("<html><body><h1>{{TITLE}}</h1><p>Lorem {ipsum} dolor {sit} amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore {et} dolore magna aliqua. </p><table>");
  count Int=this.count;
  i Int=Int(0);
  i!to(count-1) {
    if(rem(i, Int(3))==0) {
      out!append("<!-- {comment} -->");
    }
    out!append("<tr><td>{{ FIRST_NAME"+String(i)+" }}</td><td>{{LAST_NAME"+String(i)+"}}</td><td>{{  CITY"+String(i)+"  }}</td><td>{balance: "+String(rem(i, Int(100)))+"}</td></tr>\n");
    this!variable(String("FIRST_NAME")+String(i), firstName(rem(i, Int(8))));
    this!variable(String("LAST_NAME")+String(i), lastName(rem(i, Int(8))));
    this!variable(String("CITY")+String(i), city(rem(i, Int(6))));
  }
  out!append("</table></body></html>");
  this.text=out;
  return Unit();
}

String trim(text String) {
  start Int=Int(1);
  finish Int=length(text);
  i Int=Int(1);
  i!to(length(text)) {
    if(start<=finish) {
      if(byte(text, start)==32) {
        start=start+1;
      }
    }
    if(finish>=start) {
      if(byte(text, finish)==32) {
        finish=finish-1;
      }
    }
  }
  return slice(text, start, finish-start+1);
}

Int close(text Buffer, start Int) {
  i Int=start;
  i!to(length(text)-1) {
    if(byte(text, i)==125 and byte(text, i+1)==125) {
      return i;
    }
  }
  return Int(0);
}

String lookup(this State, key String) {
  index Int=this.variables:get(key);
  if(index==0) {
    return String("");
  }
  return this.values[index];
}

Unit renderParse(this State) mut {
  out Buffer=buffer(Int(0), Int(0));
  i Int=Int(1);
  k Int=Int(1);
  k!to(length(this.text)) {
    if(i<=length(this.text)) {
      replaced Bool=Bool(false);
      if(i<length(this.text)) {
        if(byte(this.text, i)==123 and byte(this.text, i+1)==123) {
          end Int=close(this.text, i+2);
          if(end>0) {
            out!append(this:lookup(trim(slice(this.text, i+2, end-i-2))));
            i=end+2;
            replaced=Bool(true);
          }
        }
      }
      if(~replaced) {
        out!push(byte(this.text, i));
        i=i+1;
      }
    }
  }
  this.rendered=out:string();
  return Unit();
}

Unit renderRegex(this State) mut {
  found Matches=regexMatches(this.pattern, this.text:string());
  out Buffer=buffer(Int(0), Int(0));
  position Int=Int(1);
  i Int=Int(1);
  i!to(found:count()) {
    start Int=found:get(i, Bool(false));
    end Int=found:get(i, Bool(true));
    out!append(slice(this.text, position, start-position));
    out!append(this:lookup(trim(slice(this.text, start+2, end-start-4))));
    position=end;
  }
  out!append(slice(this.text, position, length(this.text)-position+1));
  this.rendered=out:string();
  return Unit();
}

Unit step(this State, iteration Int) mut {
  parseMode Bool=this.parse;
  mode Bool=if(parseMode) {
    this!renderParse();
  }
  mode:else() {
    this!renderRegex();
  }
  this.result=u32(this.result+length(this.rendered));
  return Unit();
}

Int checksum(this State) => u32(this.result+hash(this.rendered));
Unit resetRandom(this State) mut {
  return Unit();
}

Result execute(this Host, cfg Config, name String) mut {
  state State=State(cfg, name);
  state!prepare();
  iterations Int=cfg:integer(name, "iterations");
  warm Int=max(Int(1), iterations/5);
  if(cfg:has(name, "warmup_iterations")) {
    warm=cfg:integer(name, "warmup_iterations");
  }
  i Int=Int(0);
  i!to(warm-1) {
    state!step(i);
  }
  state!resetRandom();
  started Int=this!start(name);
  j Int=Int(0);
  j!to(iterations-1) {
    state!step(j);
  }
  elapsed Int=this!stop(started);
  actual Int=u32(state:checksum());
  expected Int=u32(cfg:integer(name, "checksum"));
  nanos Int=this!finish(elapsed, actual, expected);
  failed Int=Int(0);
  if(actual~=expected) {
    failed=Int(1);
  }
  return Result(nanos, failed);
}
